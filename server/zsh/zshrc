[[ -o interactive ]] || return

_zsh_config_dir="${XDG_CONFIG_HOME:-$HOME/.config}/zsh"
for _zsh_module in \
  00-path.zsh \
  10-history.zsh \
  20-completion.zsh \
  30-tools.zsh \
  40-commands.zsh \
  50-prompt.zsh \
  90-highlighting.zsh; do
  source "$_zsh_config_dir/$_zsh_module"
done
unset _zsh_config_dir _zsh_module

# Machine-local, non-secret environment may be added here without entering Git.
[[ -r "${XDG_CONFIG_HOME:-$HOME/.config}/zsh.local.zsh" ]] && \
  source "${XDG_CONFIG_HOME:-$HOME/.config}/zsh.local.zsh"
