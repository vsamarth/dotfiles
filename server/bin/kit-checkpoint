#!/usr/bin/env bash

set -euo pipefail
umask 077

state_dir="${KIT_STATE_DIR:-$HOME/Kit}"
now_file="$state_dir/NOW.md"
journal_dir="$state_dir/journal"
lock_dir="$state_dir/.journal.lock"
lock_acquired=false

if [[ ! -f "$now_file" ]]; then
  printf 'Cannot checkpoint: %s is missing.\n' "$now_file" >&2
  exit 1
fi

mkdir -p "$journal_dir"
chmod 700 "$state_dir" "$journal_dir"

cleanup() {
  if "$lock_acquired"; then
    rmdir "$lock_dir" 2>/dev/null || true
  fi
}
trap cleanup EXIT
trap 'exit 130' INT
trap 'exit 143' TERM

attempt=0
until mkdir "$lock_dir" 2>/dev/null; do
  attempt=$((attempt + 1))
  if ((attempt >= 50)); then
    printf 'Could not acquire %s after 5 seconds. Confirm no ledger writer is running before removing a stale lock.\n' "$lock_dir" >&2
    exit 1
  fi
  sleep 0.1
done
lock_acquired=true

day="$(date -u '+%Y-%m-%d')"
timestamp="$(date -u '+%Y-%m-%dT%H:%M:%SZ')"
journal_file="$journal_dir/$day.md"

if [[ ! -e "$journal_file" ]]; then
  printf '# Journal — %s\n' "$day" >"$journal_file"
fi

{
  printf '\n## Checkpoint — %s\n\n' "$timestamp"
  printf 'Snapshot of `NOW.md` before a transition:\n\n'
  cat "$now_file"
  printf '\n'
} >>"$journal_file"

chmod 600 "$journal_file"
printf 'Checkpoint written to %s\n' "$journal_file"
