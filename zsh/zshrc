# Framework-free Zsh setup. Keep this file as an obvious loader; individual
# concerns live in ~/.config/zsh/ (linked to ~/.dotfiles/zsh).
[[ -o interactive ]] || return

_zsh_config_dir="${XDG_CONFIG_HOME:-$HOME/.config}/zsh"
for _zsh_module in \
  00-path.zsh \
  10-history.zsh \
  20-completion.zsh \
  30-tools.zsh \
  40-commands.zsh \
  50-prompt.zsh \
  60-atuin.zsh \
  90-highlighting.zsh; do
  source "$_zsh_config_dir/$_zsh_module"
done
unset _zsh_config_dir _zsh_module

# Machine-specific lines (installer PATH edits and the like) stay untracked.
if [[ -r ~/.zshrc.local ]]; then
  source ~/.zshrc.local
fi
